DATABASE_URL=sqlite:///./timecard.db
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
LLM_FALLBACK_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0
